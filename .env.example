SERPER_API_KEY=your_api_key_here

# Optional settings; environment variables override the .env file.
SERPER_TIMEOUT_SECONDS=30
SERPER_REQUESTS_PER_SECOND=1
SERPER_MAX_SEARCH_PAGES=15
SERPER_MAX_NO_PROGRESS_PAGES=2
MAX_CONTACT_PAGES=5

# Disabled by default; logical searches, not a guaranteed credit limit.
MAX_WEBSITE_SEARCHES=0
OUTPUT_DIR=output
LOG_LEVEL=INFO

# PostgreSQL database configuration
DATABASE_HOST=your_database_hostname
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USER=bli_app.YOUR_PROJECT_REFERENCE
DATABASE_PASSWORD=your_database_password

# Database security
DATABASE_SSLMODE=verify-full
DATABASE_SSLROOTCERT=/path/to/ca.crt

# Database connection management
DATABASE_CONNECT_TIMEOUT=10
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_STATEMENT_TIMEOUT_MS=30000


# Dedicated database migration credentials
MIGRATION_DATABASE_USER=bli_migrator.YOUR_PROJECT_REFERENCE
MIGRATION_DATABASE_PASSWORD=your_migration_password
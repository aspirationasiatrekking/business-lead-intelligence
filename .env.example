SERPER_API_KEY=your_api_key_here

# Optional settings; environment variables override the .env file.
SERPER_TIMEOUT_SECONDS=30
SERPER_REQUESTS_PER_SECOND=1
SERPER_MAX_SEARCH_PAGES=15
SERPER_MAX_NO_PROGRESS_PAGES=2
MAX_CONTACT_PAGES=5

# Disabled by default; logical searches, not a guaranteed credit limit.
MAX_WEBSITE_SEARCHES=0
OUTPUT_DIR=output
LOG_LEVEL=INFO
